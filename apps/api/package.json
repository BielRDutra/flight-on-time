{
  "name": "@flight-on-time/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/storage/migrate-cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@flight-on-time/contracts": "0.1.0",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "google-auth-library": "^11.3.4",
    "pino": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "tsx": "^4.20.6"
  }
}
